# Copy this file to .env.local and enter values from Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional: enables AI-generated business insights and business Q&A. Keep this key server-side only.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
